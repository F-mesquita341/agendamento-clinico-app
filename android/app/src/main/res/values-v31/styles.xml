<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A abertura do Android 12 em diante: o sistema desenha o ícone do
         aplicativo sobre este fundo. Sem values-night: o aplicativo tem um tema
         só, e um values-night venceria este arquivo no modo escuro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ameixa</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
