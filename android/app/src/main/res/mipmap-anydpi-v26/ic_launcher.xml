<?xml version="1.0" encoding="utf-8"?>
<!-- O ícone adaptativo (Android 8 em diante): o selo "m" do modelo, branco
     sobre a ameixa. A mesma frente serve de camada monocromática, para os
     ícones temáticos do Android 13. Os PNGs da frente e os do ícone antigo
     (Android 7) são desenhados por .claude/etapa-18/gerar_icone.dart, com a
     fonte do aplicativo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ameixa" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
