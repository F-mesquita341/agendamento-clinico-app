<?xml version="1.0" encoding="utf-8"?>
<!-- O ícone adaptativo (Android 8 em diante): o coração com batimento,
     branco, sobre o verde. A linha do batimento é recortada, e por isso a
     mesma frente serve de camada monocromática, para os ícones temáticos do
     Android 13. Os PNGs são desenhados por .claude/versao-2/gerar_icone.dart
     com o pintor das telas (lib/ui/comum/coracao.dart). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/verde" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
